# Copy to .env next to compose.yaml and fill in with real values.
#
# APP_UID/APP_GID: the container runs as these numeric ids so the bind-mounted
# data directories stay writable. Discover them on the host with `id -u` and
# `id -g` for the account that owns ./data. Do not assume the old TrueNAS
# `apps=568` account exists.
APP_UID=1000
APP_GID=1000

# Absolute host path of the media library. Mounted read-only at /media, and
# the bind fails instead of creating the directory if the path is missing, so
# a missing mount is loud rather than silent.
MEDIA_HOST_PATH=/nas/media
